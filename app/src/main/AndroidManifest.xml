<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Background survival -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Notification display (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- SMS backup (optional, runtime-requested) -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:name=".NotificationPersistentApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotificationPersistent">

        <!-- PIN gate is the launcher -->
        <activity
            android:name=".ui.PinActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".ui.ConversationActivity" android:exported="false" />
        <activity android:name=".ui.OnboardingActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />

        <!--
            NotificationListenerService.
            The system binds this once the user grants Notification Access in
            Settings → Apps → Special App Access.
            android:permission ensures only the OS can bind it.
        -->
        <service
            android:name=".service.WhatsAppNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            AccessibilityService.
            The system binds this once the user grants Accessibility Access.
        -->
        <service
            android:name=".service.WhatsAppAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Foreground survival service -->
        <service
            android:name=".service.ListenerForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Boot/update self-heal -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Watchdog 30-min heartbeat -->
        <receiver
            android:name=".alarm.WatchdogReceiver"
            android:exported="false" />

        <!-- Daily 6am SMS backup -->
        <receiver
            android:name=".alarm.DailyBackupReceiver"
            android:exported="false" />

    </application>

</manifest>
